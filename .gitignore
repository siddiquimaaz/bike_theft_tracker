# Environment (never commit secrets; .env.example files are tracked)
.env
*.env
!.env.example
!**/.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
# `venv*/` also covers the stale interpreter copies (venv_old_py311/ etc.)
venv*/
env/
.venv/
# Ad-hoc / agent test virtualenvs (not the standard `.venv/` layout)
.venv_*/

# Node
node_modules/
.vite/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# pytest
.pytest_cache/
.cache/

# Frontend build and test artifacts
btt-frontend/test-results/
playwright-report/

# Optional generated DB schema dump (use migrations instead)
btt-backend/schema.sql

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets — CRITICAL: never commit
*.pem
*.key
secrets/

# Windows portable PostgreSQL (machine-specific, too large for git)
postgresql-*/
pgsql/
# Portable database created by tools\setup.ps1 — binaries, cluster and the
# generated passwords. Deleting this folder removes the local database.
.localdb/

# Offline install archives — large, and fetched from official sources.
# vendor/README.md says which files go here and stays tracked.
vendor/*
!vendor/README.md

# Claude Code memory
.claude/

# FYP/university document — kept locally, not in repo
docs/FYP Document.docx
docs/*.docx
