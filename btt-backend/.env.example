# ─── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOCAL_DEV_MODE=False
# Disable all API rate limiting — set True only for local dev/testing.
# Keep False (or remove) in production; throttling prevents abuse.
DISABLE_THROTTLE=False

# ─── Database ──────────────────────────────────────────────────────────────────
DB_NAME=bikethefttracker
DB_USER=bttadmin
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# ─── JWT Tokens ────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_gmail@gmail.com
# Use a Gmail App Password (not your real password).
# Get one at: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Bike Theft Tracker <noreply@bikethefttracker.pk>
DISABLE_SMTP=False

# ─── Twilio SMS ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ─── App Settings ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# On Linux/Mac: /home/yourname/bike_theft_tracker/media
# On Windows:   D:\path\to\bike_theft_tracker\media
MEDIA_ROOT=/path/to/your/project/media
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png
MAX_UPLOAD_SIZE_MB=2

# ─── GeoDjango DLL paths (Windows ONLY — remove on Linux/Mac) ─────────────────
# If GDAL is system-installed (winget / OSGeo4W), you usually do NOT need these.
# Only set them if Django fails to find GDAL on startup.
# GDAL_LIBRARY_PATH=C:\Program Files\GDAL\gdal.dll
# GEOS_LIBRARY_PATH=C:\Program Files\GDAL\geos_c.dll
