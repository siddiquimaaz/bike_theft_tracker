# Copy to .env and fill in values.
# Leave VITE_API_BASE_URL empty in dev — Vite proxies /api/* to Django.
VITE_API_BASE_URL=

# Optional dev overrides (defaults shown).
# BTT uses 3001/8001 because 3000/8000 are taken by MuseAI on this machine.
# VITE_DEV_PORT=3001
# VITE_API_PROXY_TARGET=http://localhost:8001
