{
  "venvPath": ".",
  "venv": "venv",
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "include": [
    "btt-backend"
  ],
  "exclude": [
    "venv",
    "btt-frontend",
    "**/__pycache__",
    "**/*.pyc"
  ],
  "ignore": [
    "**/migrations/**"
  ],
  "reportMissingModuleSource": "none",
  "extraPaths": [
    "btt-backend"
  ]
}
